# Database
DB_URL=jdbc:postgresql://localhost:5432/template
DB_USERNAME=mydatabase
DB_PASSWORD=mydatabase

# JWT (HS256, 32 bytes 이상)
JWT_SECRET_KEY=

# Web
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Feature toggles
WEBSOCKET_ENABLED=true
REFRESH_TOKEN_STORE=rdb
AUTH_LOCAL_ENABLED=true
AUTH_SOCIAL_ENABLED=false

# Redis (REFRESH_TOKEN_STORE=redis 인 경우)
REDIS_HOST=localhost
REDIS_PORT=6379

# OAuth2 (AUTH_SOCIAL_ENABLED=true 인 경우)
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:3000/oauth/callback
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:3000/oauth/failure
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=